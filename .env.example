# ── LLM (default Groq; free tier works, see README for rate-limit notes) ───
GROQ_API_KEY=gsk_...
# Any OpenAI-compatible endpoint instead (OpenRouter, Together, Ollama, vLLM):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_CACHE=.cache/llm_cache.sqlite      ("0" disables the response cache)

# ── Stage 2: Postgres claims warehouse (python -m warehouse.load) ──────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=claims
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres
# passwords for the least-privilege login roles the loader creates
PW_ADMIN=change-me-admin
PW_ANALYST=change-me-analyst
PW_ADJUSTER=change-me-adjuster
PW_SIU=change-me-siu
PW_TRIAGE=change-me-triage
PW_OBS=change-me-obs
# TRIAGE_LOG=off            # stop logging triage decisions to triage.decisions

# Embeddings (default: local hashed n-grams, no download)
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small
# EMBED_API_KEY=sk-...
# EMBED_DIM=1536
